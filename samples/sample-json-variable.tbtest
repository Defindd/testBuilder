  "blocks": [
    {
      "$type": "apiRequest",
      "id": "66666666-6666-4666-8666-666666666666",
      "title": "POST source JSON",
      "enabled": true,
      "method": "POST",
      "url": "https://httpbin.org/post",
      "headers": [],
      "queryParams": [],
      "bodyType": "json",
      "body": "{\"customer\":{\"name\":\"Ann\",\"id\":42},\"active\":true}",
      "saveRequestJson": true,
      "saveRequestJsonVariable": "requestJson",
      "authType": "none",
      "authUser": "",
      "authPassword": "",
      "authToken": "",
      "authApiKeyName": "",
      "authApiKeyValue": "",
      "timeoutSeconds": 30,
      "responseChecks": [
        {
          "path": "$status",
          "operator": "equals",
          "expectedValue": "200"
        }
