      "saveResponseVariable": ""
    },
    {
      "$type": "apiRequest",
      "id": "77777777-7777-4777-8777-777777777777",
      "title": "POST copied JSON",
      "enabled": true,
      "method": "POST",
      "url": "https://httpbin.org/post",
      "headers": [],
      "queryParams": [],
      "bodyType": "json",
      "body": "{\"copy\":{$requestJson.customer},\"customerName\":{$requestJson.customer.name},\"active\":{$requestJson.active}}",
      "saveRequestJson": false,
      "saveRequestJsonVariable": "",
      "authType": "none",
      "authUser": "",
      "authPassword": "",
      "authToken": "",
      "authApiKeyName": "",
      "authApiKeyValue": "",
      "timeoutSeconds": 30,
      "responseChecks": [
        {
          "path": "$status",
          "operator": "equals",
          "expectedValue": "200"
        },
        {
          "path": "$.json.copy.name",
          "operator": "equals",
          "expectedValue": "Ann"
        },
        {
          "path": "$.json.customerName",
          "operator": "equals",
          "expectedValue": "Ann"
        },
        {
          "path": "$.json.active",
          "operator": "equals",
          "expectedValue": "true"
        }
      ],
      "saveResponseVariable": ""
