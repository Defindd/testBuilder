{
  "name": "Sample Simple HTTP",
  "environment": {
    "name": "public",
    "variables": {
      "baseUrl": "https://httpbin.org"
    }
  },
  "variables": {},
  "blocks": [
    {
      "$type": "apiRequest",
      "id": "11111111-1111-4111-8111-111111111111",
      "title": "POST /post",
      "enabled": true,
      "method": "POST",
      "url": "{{baseUrl}}/post",
      "headers": [],
      "queryParams": [],
      "bodyType": "json",
      "body": "{\"name\":\"test\",\"requestId\":\"{{random.uuid}}\",\"amount\":{{random.number:10:500}}}",
      "authType": "none",
      "authUser": "",
      "authPassword": "",
      "authToken": "",
      "authApiKeyName": "",
      "authApiKeyValue": "",
      "timeoutSeconds": 30,
      "responseChecks": [
        {
          "path": "$.json.name",
          "operator": "equals",
          "expectedValue": "test"
        }
      ],
      "saveResponseVariable": "lastResponse"
    }
  ]
}
